# Skopiuj ten plik do .env i uzupelnij wartosciami

PORT=3000

# Ustaw na "production" na hostingu (Railway/Render itp.) - wlacza flage Secure na ciasteczku
# sesji. Ustaw na "true" wylacznie na publicznym wdrozeniu demo - wymusza placeholder danych
# kontrahenta i wylacza prawdziwe tokeny Jira/Tempo, nawet jesli zostana przypadkiem ustawione.
NODE_ENV=
DEMO_MODE=

# Dane zleceniobiorcy wyswietlane w protokolach - PRZYKLADOWE wartosci, podmien na wlasne
CONTRACTOR_NAME=Jan Kowalski
CONTRACTOR_ADDRESS=ul. Przykladowa 1, 00-000 Warszawa
CONTRACTOR_NIP=0000000000
CONTRACTOR_JIRA_ACCOUNT_ID=
# Stawka godzinowa: patrz src/services/ratesService.js (historia stawek per miesiac)

# Jira Cloud (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://twoja-domena.atlassian.net
JIRA_EMAIL=twoj-email@example.com
JIRA_API_TOKEN=

# Tempo Cloud (Tempo -> Settings -> API Integration)
TEMPO_API_TOKEN=

# Taxxxo (link pojawiajacy sie po eksporcie)
TAXXXO_URL=https://platforma2.taxxo.pl/

# Opcjonalnie: Claude API do asystenta AI (kolejny etap rozwoju)
ANTHROPIC_API_KEY=

# Logowanie do aplikacji (ustaw przez: node scripts/set-password.js)
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
SESSION_SECRET=
