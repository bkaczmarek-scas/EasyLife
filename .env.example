# Skopiuj ten plik do .env i uzupelnij wartosciami

PORT=3000

# Connection string do Postgresa (Neon - darmowy tier, https://neon.tech). Po zalozeniu projektu
# skopiuj "Connection string" (wariant pooled, z ?sslmode=require) z panelu Neon.
DATABASE_URL=

# Ustaw na "production" na hostingu (Railway/Render itp.) - wlacza flage Secure na ciasteczku
# sesji. Ustaw na "true" wylacznie na publicznym wdrozeniu demo - wymusza placeholder danych
# kontrahenta i wylacza prawdziwe tokeny Jira/Tempo, nawet jesli zostana przypadkiem ustawione.
NODE_ENV=
DEMO_MODE=

# Dane zleceniobiorcy wyswietlane w protokolach - PRZYKLADOWE wartosci, podmien na wlasne
CONTRACTOR_NAME=Jan Kowalski
CONTRACTOR_ADDRESS=ul. Przykladowa 1, 00-000 Warszawa
CONTRACTOR_NIP=0000000000
# Inicjaly w numerze zamowienia (SC/{rok}/{mc}/01/{inicjaly}) i data umowy referencyjnej w tresci
# protokolu zdawczo-odbiorczego - rowniez PRZYKLADOWE, podmien na wlasne
CONTRACTOR_ORDER_INITIALS=XX
CONTRACTOR_AGREEMENT_DATE=01.01.2025
CONTRACTOR_JIRA_ACCOUNT_ID=
# Stawka godzinowa: patrz src/services/ratesService.js (historia stawek per miesiac)

# Jira Cloud (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_BASE_URL=https://twoja-domena.atlassian.net
JIRA_EMAIL=twoj-email@example.com
JIRA_API_TOKEN=

# Tempo Cloud (Tempo -> Settings -> API Integration)
TEMPO_API_TOKEN=

# iFirma - wystawianie faktury swiadczenia uslug poza terytorium kraju (fakturaeksportuslug.json,
# art. 28b - odwrotne obciazenie/reverse charge; wlasciwe, gdy nabywca to firma spoza Polski).
# Puste IFIRMA_USERNAME/IFIRMA_INVOICE_KEY = endpoint /api/export/ifirma zwraca 501.
# Login i klucz autoryzacji typu "faktura" generowane w panelu ifirma.pl (Ustawienia -> API) -
# klucz jest w postaci szesnastkowej, patrz .claude/skills/ifirma-integration/SKILL.md.
IFIRMA_USERNAME=
IFIRMA_INVOICE_KEY=
# Opcjonalne ustawienia faktury - patrz SKILL.md po pelna liste dozwolonych wartosci
IFIRMA_BANK_ACCOUNT=
IFIRMA_PAYMENT_METHOD=PRZ
IFIRMA_PAYMENT_TERM_DAYS=21
IFIRMA_INVOICE_LANGUAGE=en
IFIRMA_NUMBERING_SERIES=
IFIRMA_INVOICE_TEMPLATE=

# Dane nabywcy (kontrahenta) widoczne na fakturze - firma, dla ktorej wystawiana jest faktura.
# PRZYKLADOWE wartosci, podmien na wlasne - nigdy nie commituj prawdziwych danych do repo.
CLIENT_NAME=Przykladowa Sp. z o.o.
CLIENT_NIP=0000000000
CLIENT_ADDRESS_STREET=ul. Przykladowa 1
CLIENT_POSTAL_CODE=00-000
CLIENT_CITY=Warszawa
CLIENT_COUNTRY=Polska
CLIENT_COUNTRY_CODE=PL

# Opcjonalnie: Claude API do asystenta AI (kolejny etap rozwoju)
ANTHROPIC_API_KEY=

# Logowanie do aplikacji (ustaw przez: node scripts/set-password.js)
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
SESSION_SECRET=
